generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_POSTGRES_PRISMA_URL")
  directUrl = env("DATABASE_POSTGRES_URL_NON_POOLING")
}

enum Role {
  ADMIN
  CONDUCTEUR
  CHEF_CFO
  CHEF_CFA
  CLIENT
}

enum Lot {
  CFO
  CFA
}

enum Status {
  NON_RENSEIGNE
  A_VERIFIER
  A_FAIRE
  EN_COURS
  TERMINE
  BLOQUE
  SANS_OBJET
}

enum IssueStatus {
  OUVERT
  RESOLU
}

model User {
  id               String          @id @default(cuid())
  name             String
  email            String          @unique
  passwordHash     String
  role             Role
  lot              Lot?
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  teamsLed         Team[]
  audits           AuditLog[]
  itemsUpdated     WorkItem[]
  progressEntries  ProgressEntry[]
  issuesOpened     Issue[]
}

model Project {
  id          String             @id @default(cuid())
  name        String
  client      String?
  siteName    String?
  startDate   DateTime?
  endDate     DateTime?
  status      String             @default("EN_COURS")
  timezone    String             @default("UTC")
  aggregation String             @default("MOYENNE") // MOYENNE | SOMME (RG-05)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  zones       Zone[]
  levels      Level[]
  systems     System[]
  teams       Team[]
  items       WorkItem[]
  snapshots   ProgressSnapshot[]
  company          String?
  overtimeAfter    Int                @default(44)
  dailyReports     DailyReport[]
  postProgress     PostProgress[]
  timesheet        TimesheetEntry[]
  checklistPoints  ChecklistPoint[]
  nonConformities  NonConformity[]
  materialRequests MaterialRequest[]
  periodLogs       PeriodLog[]
  refItems    RefItem[]
  attachments Attachment[]
}

model Zone {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code      String
  name      String
  mainLot          String          @default("CFO/CFA")
  leaderName       String?
  plannedHeadcount Int?
  note             String?
  headcounts       ZoneHeadcount[]
  building  String?
  order     Int        @default(0)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     WorkItem[]
  teams     Team[]

  @@unique([projectId, code])
}

model Level {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     WorkItem[]

  @@unique([projectId, label])
}

model System {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lot         Lot
  name        String
  gridEnabled Boolean @default(true)
  defaultUnit String     @default("u")
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       WorkItem[]

  @@unique([projectId, lot, name])
}

model Team {
  id         String     @id @default(cuid())
  projectId  String
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lot        Lot
  leaderName String?
  name       String
  leaderId   String?
  leader     User?      @relation(fields: [leaderId], references: [id])
  matricule  String?
  headcount  Int        @default(0)
  phone      String?
  startDate  DateTime?
  note       String?
  deletedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  zones      Zone[]
  items      WorkItem[]
}

model WorkItem {
  id                String          @id @default(cuid())
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code              String?
  zoneId            String
  zone              Zone            @relation(fields: [zoneId], references: [id])
  levelId           String?
  level             Level?          @relation(fields: [levelId], references: [id])
  lot               Lot
  systemId          String?
  system            System?         @relation(fields: [systemId], references: [id])
  title             String?
  location          String?
  teamId            String?
  team              Team?           @relation(fields: [teamId], references: [id])
  plannedHeadcount  Int?
  plannedStart      DateTime?
  plannedEnd        DateTime?
  actualStart       DateTime?
  actualEnd         DateTime?
  status            Status          @default(NON_RENSEIGNE)
  manualProgress    Float?
  unit              String          @default("u")
  qtyPlanned        Float?
  qtyDone           Float?
  weight            Float           @default(1)
  material          String?
  note              String?
  lastUpdatedAt     DateTime?
  lastUpdatedById   String?
  lastUpdatedBy     User?           @relation(fields: [lastUpdatedById], references: [id])
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  entries           ProgressEntry[]
  issues            Issue[]
  kind        String  @default("GRID") // GRID = classeur B, TASK = classeur A
  responsible String?
  crew        String?

  @@unique([projectId, zoneId, levelId, systemId])
  @@index([status])
  @@index([lot])
  @@index([zoneId])
  @@index([plannedEnd])
}

model ProgressEntry {
  id           String   @id @default(cuid())
  workItemId   String
  workItem     WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  date         DateTime @default(now())
  qtyDoneTotal Float
  comment      String?
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
}

model Issue {
  id          String      @id @default(cuid())
  workItemId  String
  workItem    WorkItem    @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  description String
  status      IssueStatus @default(OUVERT)
  openedAt    DateTime    @default(now())
  closedAt    DateTime?
  resolution  String?
  openedById  String
  openedBy    User        @relation(fields: [openedById], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ProgressSnapshot {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      DateTime
  scope     String // GLOBAL | ZONE | LOT
  scopeId   String   @default("")
  progress  Float

  @@unique([projectId, date, scope, scopeId])
}







model ZoneHeadcount {
  id      String   @id @default(cuid())
  zoneId  String
  zone    Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  date    DateTime
  planned Int?
  present Int

  @@unique([zoneId, date])
}







enum NcStatus {
  OUVERT
  EN_COURS
  LEVE
}

model DailyReport {
  id            String              @id @default(cuid())
  projectId     String
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date          DateTime
  site          String
  zoneLabel     String?
  leaderName    String?
  weather       String?
  issuesText    String?
  materialText  String?
  safetyText    String?
  tomorrowText  String?
  leaderVisaBy  String?
  leaderVisaAt  DateTime?
  managerVisaBy String?
  managerVisaAt DateTime?
  createdById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  workers       DailyReportWorker[]
  systems       DailyReportSystem[]

  @@unique([projectId, date, site])
}

model DailyReportWorker {
  id       String      @id @default(cuid())
  reportId String
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  name     String
  role     String?
  hours    Float?
  note     String?
}

model DailyReportSystem {
  id          String      @id @default(cuid())
  reportId    String
  report      DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  system      String
  previousPct Float       @default(0) // 0 à 100
  todayPct    Float       @default(0)
  work        String?
}

model PostProgress {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      DateTime
  building  String   @default("") // "" = état global ; sinon matrice par bâtiment
  post      String
  system    String?
  percent   Float // 0 à 100
  note      String?

  @@unique([projectId, date, building, post])
  @@index([projectId, date])
}

model TimesheetEntry {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  weekStart DateTime // lundi
  site      String   @default("")
  name      String
  role      String?
  h1        Float?
  h2        Float?
  h3        Float?
  h4        Float?
  h5        Float?
  h6        Float?
  note      String?

  @@index([projectId, weekStart])
}

model ChecklistPoint {
  id        String            @id @default(cuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  system    String
  label     String
  order     Int               @default(0)
  results   ChecklistResult[]
}

model ChecklistResult {
  id        String         @id @default(cuid())
  pointId   String
  point     ChecklistPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  scope     String         @default("") // "" = général, sinon bâtiment
  result    String // CONFORME | NON_CONFORME
  date      DateTime?
  note      String?
  byName    String?
  updatedAt DateTime       @updatedAt

  @@unique([pointId, scope])
}

model NonConformity {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      Int
  date        DateTime
  zoneLabel   String?
  system      String?
  description String
  action      String?
  responsible String?
  status      NcStatus  @default(OUVERT)
  source      String?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([projectId, number])
}

model MaterialRequest {
  id        String         @id @default(cuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    Int
  date      DateTime
  site      String?
  status    String         @default("BROUILLON") // BROUILLON | ENVOYEE | RECUE
  createdBy String?
  createdAt DateTime       @default(now())
  lines     MaterialLine[]

  @@unique([projectId, number])
}

model MaterialLine {
  id          String          @id @default(cuid())
  requestId   String
  request     MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  position    Int             @default(0)
  designation String
  reference   String?
  unit        String?
  quantity    Float?
  wantedDate  DateTime?
  system      String?
  note        String?
}

model PeriodLog {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  workType  String
  zoneLabel String?
  system    String?
  work      String
  percent   Float?
  note      String?
  createdAt DateTime @default(now())

  @@index([projectId, startDate])
}





// Listes modifiables : bâtiments, postes d'avancement, systèmes du rapport, types de travaux
model RefItem {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      String // BUILDING | POST | REPORT_SYSTEM | WORK_TYPE
  key       String
  label     String
  short     String?
  system    String?
  order     Int     @default(0)

  @@unique([projectId, kind, key])
}

// Photos et PDF joints (stockés dans le dossier /storage)
model Attachment {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entity     String // NC | DAILY_REPORT
  entityId   String
  filename   String
  mime       String
  size       Int
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
}